# Comma-separated origins allowed to call the API
OPENCHECK_ALLOWED_ORIGINS=http://localhost:8080,https://open-text-check.lovable.app

# Google Search via serper.dev — enables web source matching
SERPER_API_KEY=

# Optional local corpus of .txt files to compare against
OPENCHECK_CORPUS_DIR=corpus

OPENCHECK_MIN_WORDS=50
OPENCHECK_MAX_WORDS=5000
OPENCHECK_MATCH_THRESHOLD=0.55
OPENCHECK_MAX_QUERIED_SENTENCES=25
OPENCHECK_MAX_UPLOAD_BYTES=5242880
